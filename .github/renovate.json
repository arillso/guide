{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>arillso/.github:renovate-base#2026-11-22"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^versions\\.env$/"],
            "matchStrings": [
                "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n[A-Z_]+=\"(?<currentValue>[^\"]+)\""
            ],
            "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^conf\\.py$/"],
            "matchStrings": ["mermaid_version = \"(?<currentValue>[^\"]+)\""],
            "datasourceTemplate": "npm",
            "depNameTemplate": "mermaid"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^\\.claude/settings\\.json$/"],
            "matchStrings": [
                "\"repo\": \"pbakaus/impeccable\",\\s*\"ref\": \"skill-v(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "pbakaus/impeccable",
            "extractVersionTemplate": "^skill-v(?<version>.+)$"
        }
    ]
}
